{
  "name": "sliding",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.6.1"
  },
  "scripts": {
    "dev": "npm -w @sliding/app run db:migrate && concurrently -n app,decks -c blue,magenta \"npm -w @sliding/app run dev\" \"curl -s --retry 60 --retry-connrefused --retry-delay 1 -o /dev/null http://localhost:8787/ && npm -w @sliding/decks run dev\"",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261118.1",
    "concurrently": "10.0.7",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  }
}
