{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Queda en sliding.aegisystem.xyz (ADR 0001).
  "name": "sliding",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sliding.aegisystem.xyz", "custom_domain": true }],
  // Un solo origen para la app: las URLs de vuelta de OAuth apuntan ahí.
  "workers_dev": false,
  // Los ids reales se ponen al desplegar (#12). En local basta con que
  // coincidan con los de apps/decks para compartir los datos.
  "kv_namespaces": [{ "binding": "DECKS", "id": "local-decks" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "sliding", "database_id": "local-sliding", "migrations_dir": "migrations" }
  ],
  "vars": { "DECKS_ORIGIN": "https://sliding-decks.pages.dev" }
}
