{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Queda en sliding.aegisystem.xyz (ADR 0001).
  "name": "sliding",
  "main": "src/index.ts",
  // Fuente, estilos y el JS del panel. Se sirven antes que el Worker.
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "sliding.aegisystem.xyz", "custom_domain": true }],
  // Un solo origen para la app: las URLs de vuelta de OAuth apuntan ahí.
  "workers_dev": false,
  "preview_urls": false,
  // Los mismos datos que apps/decks: con los mismos ids, en local también los comparten.
  "kv_namespaces": [{ "binding": "DECKS", "id": "8ae143757cbd46079c8e3e6121264195" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sliding",
      "database_id": "40e12a49-9323-4081-9933-3465ede1b6f4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "DECKS_ORIGIN": "https://decks.sliding.workers.dev",
    // Ids de cuenta de quienes moderan, separados por comas (#11). /moderacion muestra el tuyo mientras esté vacío.
    "ADMIN_USER_IDS": ""
  },
  // Una Sesión en vivo por Durable Object (ADR 0003). El plan gratis solo admite los de SQLite.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveSession"] }]
}
